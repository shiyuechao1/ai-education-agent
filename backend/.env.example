# ============ 数据库 ============
# 默认 SQLite（本地开发无需配置）
# 如需切换 MySQL，设为: mysql+pymysql://root:密码@127.0.0.1:3306/ai_education
DATABASE_URL=sqlite:///./ai_education.db

# ============ LLM 千问 API ============
# 请填入你的千问 API Key（不填则 AI 功能返回占位文本）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 向量数据库 — ChromaDB ============
CHROMA_PERSIST_DIR=./chroma_data

# ============ Embedding ============
# local = 本地 sentence-transformers（离线可用，首次运行会下载模型 ~400MB）
# dashscope = 千问 API Embedding（需要 QWEN_API_KEY）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# ============ JWT ============
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ 文件上传 ============
UPLOAD_DIR=./app/storage/uploads
